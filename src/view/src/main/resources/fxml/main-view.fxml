<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="at.htl.leonding.vinylmaster.ui.controller.MainViewController">
    <VBox fx:id="mainContent" spacing="10" style="-fx-background-color: #e3e6db;">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
        
        <VBox spacing="8" style="-fx-background-color: #e3e6db; -fx-background-radius: 10; -fx-padding: 12;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Vinyl Collection" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #8c525c;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="Search..." prefWidth="280"
                           style="-fx-background-color: #e3e6db; -fx-text-fill: #8c525c; -fx-prompt-text-fill: #8c525c; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #8c525c; -fx-padding: 8 10;"/>
                <Button fx:id="addVinylButton" text="+ Add Vinyl"
                        style="-fx-background-color: #8c525c; -fx-text-fill: #e3e6db; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18;"/>
            </HBox>
            <HBox alignment="BOTTOM_LEFT" spacing="10">
                <VBox spacing="3">
                    <Label text="Favorites" style="-fx-text-fill: #8c525c; -fx-font-size: 11px;"/>
                    <Button fx:id="favoritesFilterButton" text="☆ Favorites Only" prefWidth="170" prefHeight="32"
                            style="-fx-background-color: #e3e6db; -fx-text-fill: #8c525c; -fx-border-color: #8c525c; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4 8;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox spacing="3">
                    <Label text="Artist" style="-fx-text-fill: #8c525c; -fx-font-size: 11px;"/>
                    <ComboBox fx:id="artistFilterComboBox" promptText="All artists" prefWidth="170" prefHeight="32"
                              style="-fx-background-color: #e3e6db; -fx-text-fill: #8c525c; -fx-prompt-text-fill: #8c525c; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #8c525c; -fx-padding: 4 8;"/>
                </VBox>
                <VBox spacing="3">
                    <Label text="Genre" style="-fx-text-fill: #8c525c; -fx-font-size: 11px;"/>
                    <ComboBox fx:id="genreFilterComboBox" promptText="All genres" prefWidth="170" prefHeight="32"
                              style="-fx-background-color: #e3e6db; -fx-text-fill: #8c525c; -fx-prompt-text-fill: #8c525c; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #8c525c; -fx-padding: 4 8;"/>
                </VBox>
                <VBox spacing="3">
                    <Label text="Sort" style="-fx-text-fill: #8c525c; -fx-font-size: 11px;"/>
                    <ComboBox fx:id="sortComboBox" promptText="Sort by..." prefWidth="170" prefHeight="32"
                              style="-fx-background-color: #e3e6db; -fx-text-fill: #8c525c; -fx-prompt-text-fill: #8c525c; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #8c525c; -fx-padding: 4 8;"/>
                </VBox>
            </HBox>
        </VBox>
        
        <SplitPane fx:id="collectionSplitPane" dividerPositions="1.0" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: transparent;">
            <items>
                <ListView fx:id="vinylListView"
                          style="-fx-background-color: #e3e6db; -fx-control-inner-background: #e3e6db; -fx-border-color: #8c525c; -fx-border-radius: 8; -fx-background-radius: 8;"/>

                <VBox fx:id="detailsPanel" spacing="10" style="-fx-background-color: #e3e6db; -fx-background-radius: 8; -fx-padding: 14;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Record Details" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #8c525c;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="closeDetailsButton" text="X"
                                style="-fx-background-color: #8c525c; -fx-text-fill: #e3e6db; -fx-font-size: 12px; -fx-background-radius: 6; -fx-padding: 4 8;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <ImageView fx:id="detailImageView" fitWidth="64" fitHeight="64" preserveRatio="true"/>
                        <VBox spacing="4">
                            <HBox spacing="6">
                                <Label text="Title:" style="-fx-font-weight: bold; -fx-text-fill: #8c525c;"/>
                                <Label fx:id="detailTitleValue" text="-" style="-fx-text-fill: #8c525c;"/>
                            </HBox>
                            <HBox spacing="6">
                                <Label text="Artist:" style="-fx-font-weight: bold; -fx-text-fill: #8c525c;"/>
                                <Label fx:id="detailArtistValue" text="-" style="-fx-text-fill: #8c525c;"/>
                            </HBox>
                            <HBox spacing="8">
                                <Button fx:id="editVinylButton" text="Edit Vinyl"
                                        style="-fx-background-color: #8c525c; -fx-text-fill: #e3e6db; -fx-font-weight: bold; -fx-background-radius: 6;"/>
                                <Button fx:id="deleteVinylButton" text="Delete Vinyl"
                                        style="-fx-background-color: #8c525c; -fx-text-fill: #e3e6db; -fx-border-color: #8c525c; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                                <Button fx:id="favoriteDetailButton" text="☆"
                                        style="-fx-background-color: #e3e6db; -fx-text-fill: #8c525c; -fx-border-color: #8c525c; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 16px; -fx-padding: 4 10;"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <HBox spacing="6">
                        <Label text="Genre:" style="-fx-font-weight: bold; -fx-text-fill: #8c525c;"/>
                        <Label fx:id="detailGenreValue" text="-" style="-fx-text-fill: #8c525c;"/>
                    </HBox>
                    <HBox spacing="6">
                        <Label text="Year:" style="-fx-font-weight: bold; -fx-text-fill: #8c525c;"/>
                        <Label fx:id="detailYearValue" text="-" style="-fx-text-fill: #8c525c;"/>
                    </HBox>
                    <HBox spacing="6">
                        <Label text="Price:" style="-fx-font-weight: bold; -fx-text-fill: #8c525c;"/>
                        <Label fx:id="detailPriceValue" text="-" style="-fx-text-fill: #8c525c;"/>
                    </HBox>

                    <VBox spacing="4">
                        <Label text="Storage Location" style="-fx-font-weight: bold; -fx-text-fill: #8c525c;"/>
                        <TextField fx:id="storageLocationField" promptText="e.g. Shelf A3 / Living room"
                                   style="-fx-background-color: #e3e6db; -fx-text-fill: #8c525c; -fx-prompt-text-fill: #8c525c; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #8c525c;"/>
                    </VBox>

                    <VBox spacing="4" VBox.vgrow="ALWAYS">
                        <Label text="Notes" style="-fx-font-weight: bold; -fx-text-fill: #8c525c;"/>
                        <TextArea fx:id="notesArea" promptText="Notes for this record..." wrapText="true" prefRowCount="8" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: #e3e6db; -fx-control-inner-background: #e3e6db; -fx-text-fill: #8c525c; -fx-prompt-text-fill: #8c525c; -fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #8c525c;"/>
                    </VBox>
                </VBox>
            </items>
        </SplitPane>
    </VBox>
</StackPane>
